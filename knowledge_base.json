{
  "version": "2.0.0",
  "description": "故障排查知识库 v2.0 - 预置常见故障场景及解决方案",
  "scenarios": {
    "service_start_fail": {
      "name": "服务启动失败",
      "category": "服务管理",
      "description": "服务无法正常启动，可能由端口占用、配置错误、依赖缺失等原因导致",
      "symptoms": [
        "服务启动后立即退出",
        "报错 'Address already in use'",
        "报错 'Permission denied'",
        "报错 'ModuleNotFoundError' 或 'ImportError'"
      ],
      "questions": [
        {
          "id": "q1",
          "text": "请描述启动时看到的错误信息（关键词即可）：",
          "type": "text"
        },
        {
          "id": "q2",
          "text": "这是哪个服务？请提供服务名或端口号：",
          "type": "text"
        },
        {
          "id": "q3",
          "text": "服务是通过什么方式启动的？",
          "type": "choice",
          "options": ["systemd / service", "docker", "直接命令行运行", "IDE 运行", "其他"]
        }
      ],
      "diagnostics": [
        {
          "id": "check_port",
          "command": "netstat -ano | findstr {port}",
          "description": "检查端口是否被占用",
          "platform": "windows"
        },
        {
          "id": "check_port_linux",
          "command": "ss -tlnp | grep {port} || netstat -tlnp 2>/dev/null | grep {port}",
          "description": "检查端口是否被占用",
          "platform": "linux"
        },
        {
          "id": "check_process",
          "command": "tasklist | findstr {service_name}",
          "description": "检查服务进程是否在运行",
          "platform": "windows"
        },
        {
          "id": "check_process_linux",
          "command": "ps aux | grep {service_name} | grep -v grep",
          "description": "检查服务进程是否在运行",
          "platform": "linux"
        },
        {
          "id": "check_disk",
          "command": "wmic logicaldisk get size,freespace,caption",
          "description": "检查磁盘空间",
          "platform": "windows"
        },
        {
          "id": "check_disk_linux",
          "command": "df -h",
          "description": "检查磁盘空间",
          "platform": "linux"
        }
      ],
      "solutions": [
        {
          "title": "端口被占用",
          "condition": "端口被占用",
          "steps": [
            "确认占用端口的进程：netstat -ano | findstr <端口号>",
            "终止占用进程：taskkill /PID <PID> /F （Windows）或 kill -9 <PID>（Linux）",
            "或修改服务配置使用其他端口",
            "重新启动服务"
          ]
        },
        {
          "title": "权限不足",
          "condition": "Permission denied",
          "steps": [
            "以管理员/root 权限运行服务",
            "检查文件权限：chmod +x <可执行文件>",
            "检查配置文件是否可读"
          ]
        },
        {
          "title": "依赖缺失",
          "condition": "ModuleNotFoundError / ImportError / 找不到模块",
          "steps": [
            "安装缺失依赖：pip install <package> / npm install <package>",
            "确认使用正确的虚拟环境",
            "检查 requirements.txt / package.json 是否完整",
            "重新安装所有依赖"
          ]
        },
        {
          "title": "配置文件错误",
          "condition": "配置错误 / 语法错误 / JSON 解析失败",
          "steps": [
            "检查配置文件语法是否正确",
            "确认配置项名称和格式",
            "查看服务日志获取详细错误信息",
            "使用默认配置文件进行对比"
          ]
        },
        {
          "title": "通用排查",
          "condition": "默认",
          "steps": [
            "查看完整错误日志",
            "检查系统资源（CPU、内存、磁盘）是否充足",
            "确认服务版本与系统兼容性",
            "尝试重启系统后再次启动"
          ]
        }
      ]
    },

    "port_occupied": {
      "name": "端口占用",
      "category": "网络",
      "description": "目标端口已被其他进程占用，导致服务无法绑定该端口",
      "symptoms": [
        "报错 'Address already in use'",
        "报错 'EADDRINUSE'",
        "报错 '端口已被占用'"
      ],
      "questions": [
        {
          "id": "q1",
          "text": "被占用的端口号是多少？",
          "type": "text"
        },
        {
          "id": "q2",
          "text": "该端口应该由哪个服务使用？",
          "type": "text"
        }
      ],
      "diagnostics": [
        {
          "id": "check_port",
          "command": "netstat -ano | findstr {port}",
          "description": "查找占用端口的进程",
          "platform": "windows"
        },
        {
          "id": "check_port_linux",
          "command": "lsof -i :{port} || ss -tlnp | grep :{port}",
          "description": "查找占用端口的进程",
          "platform": "linux"
        }
      ],
      "solutions": [
        {
          "title": "释放被占用的端口",
          "condition": "默认",
          "steps": [
            "确认占用端口的进程 PID",
            "评估是否可以终止该进程",
            "Windows: taskkill /PID <PID> /F",
            "Linux: kill -9 <PID>",
            "等待几秒后重新启动服务",
            "如果不能终止，考虑更换服务端口"
          ]
        }
      ]
    },

    "connection_timeout": {
      "name": "连接超时",
      "category": "网络",
      "description": "无法在规定时间内建立网络连接",
      "symptoms": [
        "连接数据库超时",
        "API 请求超时",
        "SSH 连接超时",
        "Ping 不通目标地址"
      ],
      "questions": [
        {
          "id": "q1",
          "text": "连接的目标地址/IP 是什么？",
          "type": "text"
        },
        {
          "id": "q2",
          "text": "使用的是哪个端口？",
          "type": "text"
        },
        {
          "id": "q3",
          "text": "超时前大约等了多长时间？",
          "type": "choice",
          "options": ["几秒钟", "几十秒", "几分钟", "不确定"]
        }
      ],
      "diagnostics": [
        {
          "id": "ping",
          "command": "ping -n 4 {target}",
          "description": "测试网络连通性",
          "platform": "windows"
        },
        {
          "id": "ping_linux",
          "command": "ping -c 4 {target}",
          "description": "测试网络连通性",
          "platform": "linux"
        },
        {
          "id": "traceroute",
          "command": "tracert {target}",
          "description": "追踪路由路径",
          "platform": "windows"
        },
        {
          "id": "traceroute_linux",
          "command": "traceroute {target} || tracepath {target}",
          "description": "追踪路由路径",
          "platform": "linux"
        },
        {
          "id": "dns",
          "command": "nslookup {target}",
          "description": "检查 DNS 解析",
          "platform": "windows"
        },
        {
          "id": "dns_linux",
          "command": "dig {target} || nslookup {target}",
          "description": "检查 DNS 解析",
          "platform": "linux"
        }
      ],
      "solutions": [
        {
          "title": "网络不通",
          "condition": "Ping 不通",
          "steps": [
            "检查本机网络连接是否正常",
            "确认防火墙是否阻止了连接",
            "联系网络管理员检查链路状态",
            "尝试使用其他网络（如切换 WiFi/有线）"
          ]
        },
        {
          "title": "DNS 解析失败",
          "condition": "DNS 解析失败 / 无法解析域名",
          "steps": [
            "尝试直接用 IP 地址连接",
            "检查 /etc/hosts 或 C:\\Windows\\System32\\drivers\\etc\\hosts",
            "更换 DNS 服务器（如 8.8.8.8 或 114.114.114.114）",
            "刷新 DNS 缓存：ipconfig /flushdns"
          ]
        },
        {
          "title": "服务端口未监听",
          "condition": "连接被拒绝 / Connection refused",
          "steps": [
            "确认目标服务是否已启动",
            "检查目标服务监听的端口和地址",
            "确认防火墙是否放行该端口",
            "检查是否有中间代理或负载均衡"
          ]
        },
        {
          "title": "通用排查",
          "condition": "默认",
          "steps": [
            "检查本机防火墙和安全软件设置",
            "检查路由表是否正确",
            "确认目标地址和端口无误",
            "尝试增加客户端超时时间",
            "查看中间网络设备（路由器、交换机）状态"
          ]
        }
      ]
    },

    "disk_full": {
      "name": "磁盘空间不足",
      "category": "系统资源",
      "description": "磁盘剩余空间不足，影响服务正常运行",
      "symptoms": [
        "报错 'No space left on device'",
        "服务写日志失败",
        "数据库无法写入",
        "系统运行缓慢"
      ],
      "questions": [
        {
          "id": "q1",
          "text": "哪个磁盘/分区空间不足？",
          "type": "text"
        },
        {
          "id": "q2",
          "text": "是什么导致空间被大量占用？",
          "type": "choice",
          "options": ["日志文件", "数据库文件", "临时文件", "应用数据", "不清楚"]
        }
      ],
      "diagnostics": [
        {
          "id": "disk_usage",
          "command": "wmic logicaldisk get size,freespace,caption",
          "description": "查看磁盘使用情况",
          "platform": "windows"
        },
        {
          "id": "disk_usage_linux",
          "command": "df -h",
          "description": "查看磁盘使用情况",
          "platform": "linux"
        },
        {
          "id": "large_files",
          "command": "powershell -Command \"Get-ChildItem -Path C:\\ -Recurse -File -ErrorAction SilentlyContinue | Sort-Object Length -Descending | Select-Object -First 20 FullName, @{N='SizeMB';E={[math]::Round($_.Length/1MB,2)}}\"",
          "description": "查找最大的文件",
          "platform": "windows"
        },
        {
          "id": "large_files_linux",
          "command": "du -ah / 2>/dev/null | sort -rh | head -20",
          "description": "查找占用空间最大的目录/文件",
          "platform": "linux"
        }
      ],
      "solutions": [
        {
          "title": "清理日志文件",
          "condition": "日志文件",
          "steps": [
            "确认日志文件位置并检查大小",
            "删除旧的/已归档的日志",
            "配置日志轮转（logrotate / 自带配置）",
            "设置日志文件最大保留大小"
          ]
        },
        {
          "title": "清理临时文件",
          "condition": "临时文件",
          "steps": [
            "清理系统临时目录",
            "Windows: cleanmgr 或手动清理 %TEMP%",
            "Linux: rm -rf /tmp/*（注意不要删除正在使用的文件）",
            "检查应用临时目录是否可清理"
          ]
        },
        {
          "title": "通用清理",
          "condition": "默认",
          "steps": [
            "运行系统自带的磁盘清理工具",
            "检查并清理不需要的应用和数据",
            "考虑扩展磁盘容量或添加新磁盘",
            "配置数据自动清理策略"
          ]
        }
      ]
    },

    "high_cpu": {
      "name": "CPU 使用率过高",
      "category": "系统资源",
      "description": "CPU 占用率持续过高，导致系统响应缓慢",
      "symptoms": [
        "系统明显变慢",
        "服务响应延迟",
        "风扇高速运转",
        "监控告警 CPU > 90%"
      ],
      "questions": [
        {
          "id": "q1",
          "text": "CPU 使用率大概多少？持续多久了？",
          "type": "text"
        },
        {
          "id": "q2",
          "text": "是否有特定进程占用 CPU 较多？",
          "type": "choice",
          "options": ["自己的服务", "系统进程", "未知进程", "不确定"]
        }
      ],
      "diagnostics": [
        {
          "id": "cpu_top",
          "command": "tasklist /FO CSV | sort /R /+60",
          "description": "按 CPU 排序查看进程",
          "platform": "windows"
        },
        {
          "id": "cpu_top_linux",
          "command": "top -bn1 | head -20",
          "description": "查看 CPU 使用率最高的进程",
          "platform": "linux"
        }
      ],
      "solutions": [
        {
          "title": "应用导致 CPU 过高",
          "condition": "自己的服务",
          "steps": [
            "检查应用日志是否有异常循环或死循环",
            "使用 profiling 工具分析热点代码",
            "检查是否有内存泄漏导致频繁 GC",
            "考虑增加服务实例做负载均衡"
          ]
        },
        {
          "title": "通用排查",
          "condition": "默认",
          "steps": [
            "确认占用 CPU 的具体进程",
            "检查是否有异常进程（挖矿程序等）",
            "检查系统计划任务是否有异常",
            "考虑重启占用资源的进程",
            "如果是容器环境，检查资源限制配置"
          ]
        }
      ]
    },

    "memory_high": {
      "name": "内存使用率过高",
      "category": "系统资源",
      "description": "内存占用过高，可能导致 OOM（Out of Memory）",
      "symptoms": [
        "系统响应缓慢",
        "频繁使用交换分区/虚拟内存",
        "服务被 OOM Killer 杀死",
        "报错 'OutOfMemoryError'"
      ],
      "questions": [
        {
          "id": "q1",
          "text": "系统总内存多大？当前使用率多少？",
          "type": "text"
        },
        {
          "id": "q2",
          "text": "是否观察到内存持续增长？",
          "type": "choice",
          "options": ["是，持续增长", "突然飙升", "一直都很高", "不确定"]
        }
      ],
      "diagnostics": [
        {
          "id": "mem_usage",
          "command": "tasklist /FO CSV",
          "description": "查看进程内存使用情况",
          "platform": "windows"
        },
        {
          "id": "mem_usage_linux",
          "command": "free -h && echo '---' && ps aux --sort=-%mem | head -15",
          "description": "查看内存使用和占用最多的进程",
          "platform": "linux"
        }
      ],
      "solutions": [
        {
          "title": "内存持续增长（可能泄漏）",
          "condition": "是，持续增长",
          "steps": [
            "使用内存分析工具检测泄漏",
            "Java: jmap + MAT 分析堆转储",
            "Python: tracemalloc / memory_profiler",
            "Node.js: --inspect + Chrome DevTools",
            "修复泄漏点后重启服务"
          ]
        },
        {
          "title": "通用排查",
          "condition": "默认",
          "steps": [
            "确认内存占用最多的进程",
            "检查是否有不必要的进程在运行",
            "调整应用内存限制",
            "考虑增加物理内存或调整 swap",
            "优化数据库连接池大小"
          ]
        }
      ]
    },

    "ssl_cert": {
      "name": "SSL/TLS 证书问题",
      "category": "安全",
      "description": "SSL 证书过期、不匹配或配置错误",
      "symptoms": [
        "报错 'certificate has expired'",
        "报错 'SSL_ERROR_SYSCALL'",
        "浏览器提示不安全",
        "HTTPS 连接失败"
      ],
      "questions": [
        {
          "id": "q1",
          "text": "访问的域名是什么？",
          "type": "text"
        },
        {
          "id": "q2",
          "text": "使用的是自签名证书还是 CA 签发的？",
          "type": "choice",
          "options": ["CA 签发（如 Let's Encrypt）", "自签名证书", "企业内部 CA", "不确定"]
        }
      ],
      "diagnostics": [
        {
          "id": "cert_check",
          "command": "echo | powershell -Command \"try {{ $r = Invoke-WebRequest -Uri 'https://{domain}' -UseBasicParsing; $r.BaseResponse } catch {{ $_.Exception.InnerException }}\"",
          "description": "检查证书信息",
          "platform": "windows"
        },
        {
          "id": "cert_check_linux",
          "command": "echo | openssl s_client -connect {domain}:443 2>/dev/null | openssl x509 -noout -dates -subject",
          "description": "检查证书有效期和主体",
          "platform": "linux"
        }
      ],
      "solutions": [
        {
          "title": "证书过期",
          "condition": "expired",
          "steps": [
            "确认证书过期时间",
            "重新申请或续签证书",
            "Let's Encrypt: certbot renew",
            "更新 Nginx/Apache 配置中的证书路径",
            "重启 Web 服务",
            "验证新证书生效"
          ]
        },
        {
          "title": "证书不匹配",
          "condition": "mismatch / 不匹配",
          "steps": [
            "检查证书是否与域名匹配",
            "确认证书包含正确的 SAN（Subject Alternative Name）",
            "重新签发包含正确域名的证书",
            "检查配置中证书链是否完整"
          ]
        },
        {
          "title": "通用排查",
          "condition": "默认",
          "steps": [
            "确认系统时间是否正确",
            "检查中间证书是否安装",
            "确认 TLS 版本兼容性",
            "使用在线工具（如 SSL Labs）检测"
          ]
        }
      ]
    },

    "dns_resolution": {
      "name": "DNS 解析失败",

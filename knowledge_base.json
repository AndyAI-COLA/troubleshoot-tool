        "无法读取/写入/执行文件",
        "无法连接数据库（认证失败）"
      ],
      "questions": [
        {
          "id": "q1",
          "text": "对哪个文件/目录/服务操作时出错？",
          "type": "text"
        },
        {
          "id": "q2",
          "text": "执行的操作是什么？",
          "type": "choice",
          "options": ["读取/写入文件", "执行脚本/程序", "访问网络服务", "修改系统配置", "其他"]
        },
        {
          "id": "q3",
          "text": "当前使用的用户身份是？",
          "type": "choice",
          "options": ["普通用户", "root / 管理员", "服务账号", "不确定"]
        }
      ],
      "diagnostics": [
        {
          "id": "check_file_perm",
          "command": "ls -la {q1}",
          "description": "查看文件/目录权限",
          "platform": "linux"
        },
        {
          "id": "check_file_perm_win",
          "command": "icacls \"{q1}\"",
          "description": "查看文件/目录权限",
          "platform": "windows"
        },
        {
          "id": "check_user",
          "command": "whoami && id",
          "description": "查看当前用户和所属组",
          "platform": "linux"
        },
        {
          "id": "check_user_win",
          "command": "whoami /priv",
          "description": "查看当前用户权限",
          "platform": "windows"
        }
      ],
      "solutions": [
        {
          "title": "文件/目录权限不足",
          "condition": "读取/写入文件 / 执行脚本/程序",
          "steps": [
            "确认当前用户身份: whoami",
            "检查文件权限: ls -la <文件> / icacls <文件>",
            "修改权限: chmod 755 <文件> 或 chmod +x <可执行文件>",
            "修改属主: chown <user>:<group> <文件>",
            "必要时使用 sudo 提权（谨慎操作）",
            "避免长期使用 root 运行应用"
          ]
        },
        {
          "title": "网络服务认证失败",
          "condition": "访问网络服务",
          "steps": [
            "确认用户名和密码是否正确",
            "检查服务端用户权限配置",
            "检查数据库 GRANT 授权是否完整",
            "确认 API Key / Token 是否有效",
            "检查防火墙/安全组是否放行"
          ]
        },
        {
          "title": "通用排查",
          "condition": "默认",
          "steps": [
            "确认操作的用户身份和权限",
            "检查 SELinux / AppArmor 策略",
            "查看系统审计日志: audit.log / event.log",
            "使用 sudo -l 查看 sudo 权限",
            "咨询管理员授予所需权限"
          ]
        }
      ]
    },

    "config_error": {
      "name": "配置错误",
      "category": "系统管理",
      "description": "服务配置文件语法错误、格式问题或配置项缺失导致服务异常",
      "symptoms": [
        "服务启动报 'config error' / 'parse error'",
        "报错 'YAMLException' / 'JSON parse error'",
        "服务启动但行为异常",
        "环境变量未生效",
        "配置项未被识别"
      ],
      "questions": [
        {
          "id": "q1",
          "text": "哪个服务/应用出了问题？",
          "type": "text"
        },
        {
          "id": "q2",
          "text": "配置文件格式是什么？",
          "type": "choice",
          "options": ["YAML (.yml/.yaml)", "JSON (.json)", "INI (.ini/.conf)", "TOML (.toml)", "XML (.xml)", "Properties (.properties)", "环境变量 (.env)", "不确定"]
        },
        {
          "id": "q3",
          "text": "最近是否修改过配置文件？",
          "type": "choice",
          "options": ["是，刚修改过", "否，一直没改过", "不确定"]
        }
      ],
      "diagnostics": [
        {
          "id": "check_env",
          "command": "env | sort",
          "description": "查看当前环境变量",
          "platform": "linux"
        },
        {
          "id": "check_env_win",
          "command": "set",
          "description": "查看当前环境变量",
          "platform": "windows"
        }
      ],
      "solutions": [
        {
          "title": "YAML/JSON 语法错误",
          "condition": "YAML / JSON",
          "steps": [
            "使用在线校验工具检查语法 (yamlLint / jsonlint)",
            "注意缩进一致性（YAML 不要混用 Tab 和空格）",
            "检查括号、引号是否匹配",
            "对比 git diff 查看最近修改",
            "恢复到上一个正常版本进行对比"
          ]
        },
        {
          "title": "环境变量未生效",
          "condition": "环境变量 / .env",
          "steps": [
            "检查 .env 文件路径是否正确",
            "确认变量名拼写和大小写",
            "重新加载环境变量: source .env / export $(cat .env | xargs)",
            "检查是否有空格或特殊字符未加引号",
            "确认服务进程是否需要重启才能读取新变量"
          ]
        },
        {
          "title": "通用排查",
          "condition": "默认",
          "steps": [
            "查看服务日志获取详细错误信息",
            "检查配置文件编码（应为 UTF-8 无 BOM）",
            "使用配置文件校验工具: nginx -t / httpd -t / java -jar config-check.jar",
            "对比文档确认配置项名称和值的格式",
            "尝试使用最小化配置启动"
          ]
        }
      ]
    },

    "firewall_block": {
      "name": "防火墙 / 安全组拦截",
      "category": "网络安全",
      "description": "本机防火墙或云安全组阻止了网络通信",
      "symptoms": [
        "telnet / nc 端口不通",
        "本机可访问但外部无法访问",
        "SSH 连接被拒绝",
        "HTTP 请求无响应",
        "云服务器从外部无法连通"
      ],
      "questions": [
        {
          "id": "q1",
          "text": "被阻止的端口号是多少？",
          "type": "text"
        },
        {
          "id": "q2",
          "text": "服务器部署在哪里？",
          "type": "choice",
          "options": ["本地物理机", "VMware/VirtualBox 虚拟机", "阿里云", "腾讯云", "AWS", "Docker 容器", "其他云/IDC"]
        },
        {
          "id": "q3",
          "text": "本机 localhost 能访问该服务吗？",
          "type": "choice",
          "options": ["可以", "也不行", "没试过"]
        }
      ],
      "diagnostics": [
        {
          "id": "check_listen",
          "command": "netstat -ano | findstr {port}",
          "description": "检查服务是否在监听端口",
          "platform": "windows"
        },
        {
          "id": "check_listen_linux",
          "command": "ss -tlnp | grep :{port} || netstat -tlnp 2>/dev/null | grep :{port}",
          "description": "检查服务是否在监听端口",
          "platform": "linux"
        },
        {
          "id": "check_fw_linux",
          "command": "sudo iptables -L -n 2>/dev/null || sudo nft list ruleset 2>/dev/null",
          "description": "查看 iptables/nftables 规则",
          "platform": "linux"
        },
        {
          "id": "check_fw_win",
          "command": "netsh advfirewall firewall show rule name=all dir=in | findstr /i \"{port}\"",
          "description": "查看 Windows 入站防火墙规则",
          "platform": "windows"
        }
      ],
      "solutions": [
        {
          "title": "本地防火墙阻止",
          "condition": "本地物理机 / VMware / 虚拟机",
          "steps": [
            "确认服务已在监听: ss -tlnp / netstat -ano",
            "放行端口: sudo iptables -A INPUT -p tcp --dport <端口> -j ACCEPT",
            "或关闭防火墙测试: sudo systemctl stop firewalld",
            "Windows: 高级安全防火墙 → 新建入站规则",
            "测试通过后记得配置正式规则"
          ]
        },
        {
          "title": "云安全组未放行",
          "condition": "阿里云 / 腾讯云 / AWS / 其他云",
          "steps": [
            "登录云控制台 → 安全组",
            "添加入站规则: 允许 TCP <端口>",
            "设置授权对象（来源 IP），生产环境不要用 0.0.0.0/0",
            "检查是否有多层安全组嵌套",
            "确认 ECS 实例本身的安全组已关联"
          ]
        },
        {
          "title": "Docker 端口映射",
          "condition": "Docker 容器",
          "steps": [
            "检查容器端口映射: docker port <容器名>",
            "确认 -p 参数: docker run -p <宿主机端口>:<容器端口>",
            "检查宿主机防火墙是否放行宿主机端口",
            "docker network inspect 查看网络配置"
          ]
        },
        {
          "title": "通用排查",
          "condition": "默认",
          "steps": [
            "确认服务正常监听: ss -tlnp / netstat -ano",
            "本地测试: curl localhost:<端口> / telnet 127.0.0.1 <端口>",
            "检查 iptables / firewalld / ufw / Windows Firewall 规则",
            "检查路由和 NAT 配置",
            "使用 traceroute 定位丢包节点"
          ]
        }
      ]
    },

    "service_high_latency": {
      "name": "服务响应高延迟",
      "category": "性能",
      "description": "服务可访问但响应时间过长，用户体验差",
      "symptoms": [
        "HTTP 接口响应 > 3秒",
        "数据库查询缓慢",
        "API 调用经常超时",
        "页面加载时间过长",
        "用户投诉系统很慢"
      ],
      "questions": [
        {
          "id": "q1",
          "text": "哪个接口/操作特别慢？",
          "type": "text"
        },
        {
          "id": "q2",
          "text": "延迟大约在什么量级？",
          "type": "choice",
          "options": ["几百毫秒", "1-3 秒", "3-10 秒", "经常超时(>10s)"]
        },
        {
          "id": "q3",
          "text": "是一直慢还是突然变慢？",
          "type": "choice",
          "options": ["一直都比较慢", "突然变慢", "高峰期才慢", "不确定"]
        }
      ],
      "diagnostics": [
        {
          "id": "check_load",
          "command": "uptime",
          "description": "查看系统负载",
          "platform": "linux"
        },
        {
          "id": "check_load_win",
          "command": "powershell -Command \"Get-Process | Sort-Object CPU -Descending | Select-Object -First 10 Name, CPU, WorkingSet64 | Format-Table -AutoSize\"",
          "description": "查看 CPU 消耗最高的进程",
          "platform": "windows"
        },
        {
          "id": "check_connections",
          "command": "ss -s 2>/dev/null || netstat -s 2>/dev/null | head -20",
          "description": "查看网络连接统计",
          "platform": "linux"
        },
        {
          "id": "check_connections_win",
          "command": "netstat -ano | findstr ESTISHED | find /c /v \"\"",
          "description": "统计当前活跃连接数",
          "platform": "windows"
        }
      ],
      "solutions": [
        {
          "title": "数据库慢查询",
          "condition": "数据库查询",
          "steps": [
            "开启慢查询日志: slow_query_log = ON",
            "分析慢查询: mysqldumpslow / pg_stat_statements",
            "检查是否缺少索引: EXPLAIN <query>",
            "检查数据库连接池配置（是否耗尽）",
            "考虑读写分离或缓存热点数据"
          ]
        },
        {
          "title": "连接池耗尽",
          "condition": "连接池",
          "steps": [
            "检查当前连接数: SHOW PROCESSLIST / ss -s",
            "调整连接池大小: min-idle / max-active",
            "检查连接泄漏: 是否有未关闭的连接",
            "添加连接超时配置: connection-timeout",
            "考虑使用连接池监控"
          ]
        },
        {
          "title": "系统负载过高",
          "condition": "负载高",
          "steps": [
            "检查负载: uptime（load average 应 < CPU 核数）",
            "定位高 CPU 进程: top / ps aux --sort=-%cpu",
            "定位高 IO: iostat -x 1 / iotop",
            "检查内存是否频繁 swap: vmstat 1",
            "考虑扩容或限流"
          ]
        },
        {
          "title": "通用排查",
          "condition": "默认",
          "steps": [
            "使用 curl -w 计时: curl -o /dev/null -s -w '%{time_total}' <url>",
            "检查网络延迟: ping <目标>、traceroute <目标>",
            "查看应用日志中的耗时记录",
            "检查 DNS 解析时间",
            "使用 APM 工具（如 SkyWalking、Pinpoint）定位瓶颈"
          ]
        }
      ]
    }
  },
